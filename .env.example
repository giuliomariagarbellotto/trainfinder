# Nome con cui il server si presenta alle API (Digitraffic-User, ET-Client-Name). Usa qualcosa di identificabile.
CLIENT_NAME=trainfinder

# Porta esposta da docker compose
WEB_PORT=80

# Fonti attive (vuoto = tutte). Valori: fi-digitraffic,no-entur,ie-irishrail,it-viaggiatreno,gb-networkrail-td
ENABLED_SOURCES=

# Geometria dei binari per le posizioni stimate (generata con data/build-rail-network.mjs).
# Percorso visto dal container: i file in ./data finiscono in /app/data.
RAIL_NETWORK_FILE=

# Italia (ViaggiaTreno): opzioni di carico
# IT_HUB_STATIONS=MILANO CENTRALE,ROMA TERMINI
# IT_MAX_TRAINS=1500
# IT_TRAIN_REFRESH_MS=240000
# IT_CONCURRENCY=3

# Regno Unito: account gratuito su https://publicdatafeeds.networkrail.co.uk (abilitare il feed TD)
NROD_USER=
NROD_PASSWORD=
UK_BERTHS_FILE=
